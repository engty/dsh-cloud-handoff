{
  "name": "dsh-cloud-handoff",
  "version": "0.1.0",
  "description": "「云接力」：把本地 DSH 会话一键迁到云端 DSH 继续执行，笔记本合盖/关机不中断；回本地重开自动同步云端结果（DeepSeek Harness 插件）",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cloud",
    "handoff",
    "remote",
    "sync"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.3 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "scripts": {
    "test": "node --test test/"
  }
}
